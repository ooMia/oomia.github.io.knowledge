{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ooMia/oomia.github.io.knowledge/blob/main/schemas/content-component-manifest.schema.json",
  "title": "Custom Content Component Profile",
  "description": "Deferred planning schema for an optional cross-repository custom content-component contract used when Fumadocs built-ins are insufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "props",
        "children"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "kind": {
          "enum": [
            "block",
            "inline"
          ]
        },
        "props": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/prop"
          }
        },
        "children": {
          "enum": [
            "none",
            "text",
            "markdown",
            "mdx"
          ]
        }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "enum",
            "string-array",
            "number-array",
            "object"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    }
  }
}
